{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer administrative read receipt v1",
  "description": "Source contract for fincore.customer.access.recorded.v1. Key/aggregateId/eventId must be equal; aggregateVersion is 1. Runtime additionally enforces outcome/status consistency. RESPONSE_READY is a pre-transport decision. SIGNED_JWT is the Customer producer's assertion, not independent central verification. Unknown fields are dropped by central projection.",
  "allOf": [
    { "$ref": "domain-event-v1.json" },
    {
      "properties": {
        "eventType": { "const": "customer.access.recorded" },
        "aggregateVersion": { "const": 1 },
        "correlationId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "outcome", "httpMethod", "httpStatus", "actorProvenance"],
          "properties": {
            "action": { "enum": ["CUSTOMER_SEARCH", "CUSTOMER_INSPECT"] },
            "outcome": { "enum": ["RESPONSE_READY", "INVALID_REQUEST", "UNAUTHENTICATED", "FORBIDDEN", "NOT_FOUND", "SERVER_ERROR"] },
            "httpMethod": { "enum": ["GET", "POST", "OTHER"] },
            "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
            "actorProvenance": { "enum": ["SIGNED_JWT", "UNAVAILABLE"] },
            "actorSubject": { "type": "string", "pattern": "^[A-Za-z0-9:_-]{1,200}$" },
            "customerId": { "type": "string", "format": "uuid" }
          },
          "allOf": [
            {
              "if": { "properties": { "actorProvenance": { "const": "SIGNED_JWT" } } },
              "then": { "required": ["actorSubject"] },
              "else": { "not": { "required": ["actorSubject"] } }
            },
            {
              "if": { "properties": { "action": { "const": "CUSTOMER_SEARCH" } } },
              "then": { "not": { "required": ["customerId"] } }
            }
          ]
        }
      }
    }
  ]
}
