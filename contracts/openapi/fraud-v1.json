{
  "openapi": "3.0.3",
  "info": {
    "title": "FinCore synchronous fraud and investigation",
    "version": "0.6.0",
    "description": "Private owner contexts are authoritative. ADMIN alone grants no Fraud access. Decisions authorize reassessment, never settlement. Grants expire after thirty seconds; no instantaneous distributed revocation is claimed."
  },
  "servers": [
    {
      "url": "http://localhost:8280"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/api/v1/admin/fraud-cases": {
      "get": {
        "summary": "FRAUD_ANALYST current work queue, at most 50, latest assessment first",
        "responses": {
          "200": {
            "description": "items and nullable nextCursor (sequence text). Cases may move after reassessment; alerts are immutable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or filter"
          },
          "401": {
            "description": "Invalid bearer"
          },
          "403": {
            "description": "Insufficient role or invalid authorization"
          },
          "409": {
            "description": "Version, state or idempotency conflict"
          },
          "503": {
            "description": "Required owner unavailable; no permissive fallback"
          }
        },
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "OPEN",
                "APPROVED",
                "REJECTED",
                "BLOCKED",
                "CLEARED"
              ]
            }
          }
        ]
      }
    },
    "/api/v1/admin/fraud-alerts": {
      "get": {
        "summary": "FRAUD_ANALYST immutable initial alerts, at most 50, stable descending sequence cursor",
        "responses": {
          "200": {
            "description": "items and nullable nextCursor (sequence text). Cases may move after reassessment; alerts are immutable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "nextCursor": {
                      "type": "string",
                      "nullable": true
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or filter"
          },
          "401": {
            "description": "Invalid bearer"
          },
          "403": {
            "description": "Insufficient role or invalid authorization"
          },
          "409": {
            "description": "Version, state or idempotency conflict"
          },
          "503": {
            "description": "Required owner unavailable; no permissive fallback"
          }
        },
        "parameters": [
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ]
      }
    },
    "/api/v1/admin/fraud-cases/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "FRAUD_ANALYST case, canonical context, latest assessment, original alerts and append-only decisions",
        "responses": {
          "200": {
            "description": "caseId, paymentId, version, status, rulesVersion, assessment, context, alerts, decisions. payment holds actual status/version/journalId/riskAssessmentId; on unavailable owner it is null and paymentUnavailable is true. No optimistic settlement."
          },
          "400": {
            "description": "Invalid body or filter"
          },
          "401": {
            "description": "Invalid bearer"
          },
          "403": {
            "description": "Insufficient role or invalid authorization"
          },
          "409": {
            "description": "Version, state or idempotency conflict"
          },
          "503": {
            "description": "Required owner unavailable; no permissive fallback"
          }
        }
      }
    },
    "/api/v1/admin/fraud-cases/{id}/decisions": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "summary": "Record an audited analyst decision; 200 does not confirm money movement",
        "responses": {
          "200": {
            "description": "Recorded result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "decisionId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "caseId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "version": {
                      "type": "integer",
                      "format": "int64",
                      "minimum": 1
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "APPROVED",
                        "REJECTED"
                      ]
                    }
                  },
                  "required": [
                    "decisionId",
                    "caseId",
                    "version",
                    "status"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or filter"
          },
          "401": {
            "description": "Invalid bearer"
          },
          "403": {
            "description": "Insufficient role or invalid authorization"
          },
          "409": {
            "description": "Version, state or idempotency conflict"
          },
          "503": {
            "description": "Required owner unavailable; no permissive fallback"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expectedVersion": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  },
                  "approve": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "pattern": "^[A-Z_]{3,100}$"
                  }
                },
                "required": [
                  "expectedVersion",
                  "approve",
                  "reason"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,120}$"
            },
            "description": "Preserve exact key/body/version after an unknown response. Different intent conflicts."
          }
        ]
      }
    },
    "/api/v1/admin/fraud-rules": {
      "get": {
        "summary": "FRAUD_ANALYST current versioned simulation rules",
        "responses": {
          "200": {
            "description": "Recorded result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionedRules"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or filter"
          },
          "401": {
            "description": "Invalid bearer"
          },
          "403": {
            "description": "Insufficient role or invalid authorization"
          },
          "409": {
            "description": "Version, state or idempotency conflict"
          },
          "503": {
            "description": "Required owner unavailable; no permissive fallback"
          }
        }
      },
      "put": {
        "summary": "Append rules using expectedVersion; exact natural-version retry returns the original result",
        "responses": {
          "200": {
            "description": "Recorded result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionedRules"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or filter"
          },
          "401": {
            "description": "Invalid bearer"
          },
          "403": {
            "description": "Insufficient role or invalid authorization"
          },
          "409": {
            "description": "Version, state or idempotency conflict"
          },
          "503": {
            "description": "Required owner unavailable; no permissive fallback"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expectedVersion": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  },
                  "rules": {
                    "$ref": "#/components/schemas/Rules"
                  },
                  "reason": {
                    "type": "string",
                    "pattern": "^[A-Z_]{3,100}$"
                  }
                },
                "required": [
                  "expectedVersion",
                  "rules",
                  "reason"
                ]
              }
            }
          }
        }
      }
    },
    "/internal/v1/risk-assessments": {
      "servers": [
        {
          "url": "http://fraud-service:8080"
        }
      ],
      "post": {
        "summary": "fraud.assess only; fetch required canonical owner facts before the assessment transaction",
        "responses": {
          "200": {
            "description": "Recorded result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Assessment"
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or filter"
          },
          "401": {
            "description": "Invalid bearer"
          },
          "403": {
            "description": "Insufficient role or invalid authorization"
          },
          "409": {
            "description": "Version, state or idempotency conflict"
          },
          "503": {
            "description": "Required owner unavailable; no permissive fallback"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paymentId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "paymentId"
                ]
              }
            }
          }
        }
      }
    },
    "/internal/v1/risk-assessments/{id}/validate": {
      "servers": [
        {
          "url": "http://fraud-service:8080"
        }
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "summary": "fraud.validate only; exact payment, Ledger fingerprint and unexpired ALLOW",
        "responses": {
          "200": {
            "description": "Recorded result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "assessmentId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "paymentId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "fingerprint": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "assessmentId",
                    "paymentId",
                    "fingerprint",
                    "expiresAt"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid body or filter"
          },
          "401": {
            "description": "Invalid bearer"
          },
          "403": {
            "description": "Insufficient role or invalid authorization"
          },
          "409": {
            "description": "Version, state or idempotency conflict"
          },
          "503": {
            "description": "Required owner unavailable; no permissive fallback"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paymentId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "paymentId",
                  "fingerprint"
                ]
              }
            }
          }
        }
      }
    },
    "/internal/v1/fraud/payments/{id}/decision": {
      "servers": [
        {
          "url": "http://fraud-service:8080"
        }
      ],
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "summary": "fraud.review compatibility bridge; expectedVersion is the actual Payment version, not case version",
        "responses": {
          "200": {
            "description": "Recorded result"
          },
          "400": {
            "description": "Invalid body or filter"
          },
          "401": {
            "description": "Invalid bearer"
          },
          "403": {
            "description": "Insufficient role or invalid authorization"
          },
          "409": {
            "description": "Version, state or idempotency conflict"
          },
          "503": {
            "description": "Required owner unavailable; no permissive fallback"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "expectedVersion": {
                    "type": "integer",
                    "format": "int64",
                    "minimum": 1
                  },
                  "approve": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "pattern": "^[A-Z_]{3,100}$"
                  }
                },
                "required": [
                  "expectedVersion",
                  "approve",
                  "reason"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Explanation": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "score": {
            "type": "integer"
          },
          "observed": {
            "type": "string"
          },
          "threshold": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "score",
          "observed",
          "threshold"
        ]
      },
      "Assessment": {
        "type": "object",
        "properties": {
          "assessmentId": {
            "type": "string",
            "format": "uuid"
          },
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "ALLOW",
              "REVIEW",
              "BLOCK"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "rulesVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Explanation"
            }
          }
        },
        "required": [
          "assessmentId",
          "paymentId",
          "verdict",
          "score",
          "rulesVersion",
          "expiresAt",
          "reasons"
        ]
      },
      "Rules": {
        "type": "object",
        "properties": {
          "reviewAmounts": {
            "type": "object",
            "properties": {
              "MAD": {
                "type": "string",
                "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
              },
              "EUR": {
                "type": "string",
                "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
              },
              "USD": {
                "type": "string",
                "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
              }
            },
            "required": [
              "MAD",
              "EUR",
              "USD"
            ]
          },
          "blockAmounts": {
            "type": "object",
            "properties": {
              "MAD": {
                "type": "string",
                "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
              },
              "EUR": {
                "type": "string",
                "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
              },
              "USD": {
                "type": "string",
                "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
              }
            },
            "required": [
              "MAD",
              "EUR",
              "USD"
            ]
          },
          "newBeneficiaryAmounts": {
            "type": "object",
            "properties": {
              "MAD": {
                "type": "string",
                "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
              },
              "EUR": {
                "type": "string",
                "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
              },
              "USD": {
                "type": "string",
                "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
              }
            },
            "required": [
              "MAD",
              "EUR",
              "USD"
            ]
          },
          "frequencyReview": {
            "type": "integer",
            "minimum": 2,
            "maximum": 500
          },
          "frequencyBlock": {
            "type": "integer",
            "minimum": 2,
            "maximum": 1000
          },
          "rapidCount": {
            "type": "integer",
            "minimum": 2,
            "maximum": 500
          },
          "velocityCount": {
            "type": "integer",
            "minimum": 2,
            "maximum": 500
          },
          "failedCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "newBeneficiaryHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 168
          },
          "flaggedCountries": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        },
        "required": [
          "reviewAmounts",
          "blockAmounts",
          "newBeneficiaryAmounts",
          "frequencyReview",
          "frequencyBlock",
          "rapidCount",
          "velocityCount",
          "failedCount",
          "newBeneficiaryHours",
          "flaggedCountries"
        ],
        "description": "Positive exact amounts; newBeneficiary <= review < block in each currency. frequencyBlock >= frequencyReview. No FX."
      },
      "VersionedRules": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "rules": {
            "$ref": "#/components/schemas/Rules"
          },
          "actor": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "version",
          "rules",
          "actor",
          "reason",
          "createdAt"
        ]
      }
    }
  }
}
